-- ---------------------------------------------------------------------------
-- Backup / restore
--
-- The built-in categories are restored along with the user's own: their ids are
-- referenced by transactions, and the seeded copies carry the same ids, so
-- replacing the table wholesale keeps every transaction's label intact.
-- ---------------------------------------------------------------------------

backupInsertCategory:
INSERT INTO Category(
    id, name, icon_key, applies_to, is_built_in, is_protected, is_archived, sort_order, created_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

backupDeleteAllCategories:
DELETE FROM Category;
