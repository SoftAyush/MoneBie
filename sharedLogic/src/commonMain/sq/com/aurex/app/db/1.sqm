-- Schema v1 -> v2: financial accounts.
-- Ships as a migration so installs created during the onboarding/account-setup
-- phase upgrade in place instead of crashing on a missing table.
CREATE TABLE Account (
    id            INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name          TEXT    NOT NULL,
    type          TEXT    NOT NULL,
    balance_minor INTEGER NOT NULL DEFAULT 0,
    currency_code TEXT    NOT NULL,
    is_archived   INTEGER NOT NULL DEFAULT 0,
    created_at    TEXT    NOT NULL,
    FOREIGN KEY (currency_code) REFERENCES Currency(code) ON UPDATE CASCADE
);

CREATE INDEX account_archived ON Account(is_archived);
