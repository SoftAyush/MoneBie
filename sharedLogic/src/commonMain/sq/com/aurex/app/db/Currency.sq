CREATE TABLE Currency (
    code    TEXT    NOT NULL PRIMARY KEY,
    symbol  TEXT    NOT NULL,
    name    TEXT    NOT NULL,
    flag    TEXT    NOT NULL DEFAULT '🏳️',
    popular INTEGER NOT NULL DEFAULT 0  -- 1 = popular, 0 = not popular
);

-- The currency list, verbatim from the canonical list this project keeps.
-- A fresh install is seeded from here; an existing one is brought to the same
-- state by 6.sqm. CurrencySeedTest fails the moment the two disagree, which is
-- the only thing keeping the duplication honest.
