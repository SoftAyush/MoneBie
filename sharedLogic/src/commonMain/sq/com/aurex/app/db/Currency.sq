insertCurrency:
INSERT OR IGNORE INTO Currency (code, symbol, name, flag, popular) VALUES (?, ?, ?, ?, ?);

selectAllCurrencies:
SELECT * FROM Currency ORDER BY popular DESC, name ASC;
