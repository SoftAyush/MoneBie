CREATE TABLE Account (
    id            INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name          TEXT    NOT NULL,
    type          TEXT    NOT NULL,
    -- Money is stored in minor units (cents/paisa) as an INTEGER.
    -- REAL would accumulate rounding error across thousands of postings.
    balance_minor INTEGER NOT NULL DEFAULT 0,
    currency_code TEXT    NOT NULL,
    is_archived   INTEGER NOT NULL DEFAULT 0,
    created_at    TEXT    NOT NULL,
    FOREIGN KEY (currency_code) REFERENCES Currency(code) ON UPDATE CASCADE
);

CREATE INDEX account_archived ON Account(is_archived);

selectAllAccounts:
SELECT * FROM Account ORDER BY is_archived ASC, id ASC;

selectActiveAccounts:
SELECT * FROM Account WHERE is_archived = 0 ORDER BY id ASC;

getAccountById:
SELECT * FROM Account WHERE id = ?;

countActiveAccounts:
SELECT COUNT(*) FROM Account WHERE is_archived = 0;

insertAccount:
INSERT INTO Account(name, type, balance_minor, currency_code, is_archived, created_at)
VALUES (?, ?, ?, ?, 0, ?);

lastInsertedAccountId:
SELECT last_insert_rowid();

updateAccount:
UPDATE Account SET name = ?, type = ? WHERE id = ?;

setAccountBalance:
UPDATE Account SET balance_minor = ? WHERE id = ?;

-- Relative adjustment, used when posting a transaction, debt payment or EMI
-- installment. Applying a delta rather than writing an absolute balance keeps
-- concurrent postings from clobbering each other.
adjustAccountBalance:
UPDATE Account SET balance_minor = balance_minor + :delta WHERE id = :id;

archiveAccount:
UPDATE Account SET is_archived = 1 WHERE id = ?;

-- ---------------------------------------------------------------------------
-- Backup / restore
--
-- Ids are written and read back explicitly. Transactions, debts, EMIs and loan
-- records all point at accounts by rowid, so letting AUTOINCREMENT hand out
-- fresh ids on restore would silently reattach every one of those rows to the
-- wrong account.
-- ---------------------------------------------------------------------------

backupInsertAccount:
INSERT INTO Account(id, name, type, balance_minor, currency_code, is_archived, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

backupDeleteAllAccounts:
DELETE FROM Account;
