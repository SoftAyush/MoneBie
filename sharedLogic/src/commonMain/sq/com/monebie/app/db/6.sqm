-- Schema v6 -> v7: bring the currency table to the canonical list.
--
-- Two statements per currency, not one. INSERT OR IGNORE alone would only add
-- the missing codes and leave the twenty an existing install already has frozen
-- at their old values - so an upgraded user would keep seeing A$ for the
-- Australian dollar while a fresh install shows $. The UPDATE lands first and
-- is a no-op when the row is absent; the INSERT is a no-op when it is present.
--
-- Deliberately an UPDATE rather than INSERT OR REPLACE: replace deletes the row
-- first, and User.currency_code is a foreign key onto it.
--
-- Nothing is deleted. A user may be pegged to a code that has since left the
-- list, and orphaning their profile to tidy the table is not a trade worth making.
UPDATE Currency SET symbol = 'د.إ', name = 'UAE Dirham', flag = '🇦🇪', popular = 0 WHERE code = 'AED';
INSERT OR IGNORE INTO Currency (code, symbol, name, flag, popular) VALUES ('AED', 'د.إ', 'UAE Dirham', '🇦🇪', 0);
UPDATE Currency SET symbol = '؋', name = 'Afghan Afghani', flag = '🇦🇫', popular = 0 WHERE code = 'AFN';
INSERT OR IGNORE INTO Currency (code, symbol, name, flag, popular) VALUES ('AFN', '؋', 'Afghan Afghani', '🇦🇫', 0);
