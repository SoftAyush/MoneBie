-- Schema v9 -> v10: budgets and recurring transactions (MoneBie 1.1.0).
--
-- Both tables are additive. Nothing about existing rows changes: a recurring
-- occurrence is posted to TransactionRecord with a source_type of RECURRING,
-- which the column already accepts as free text, and a budget is measured
-- against the rows that are already there.
CREATE TABLE Budget (
    id           INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    category_id  TEXT    NOT NULL,
    amount_minor INTEGER NOT NULL,
    period       TEXT    NOT NULL DEFAULT 'MONTHLY',
    created_at   TEXT    NOT NULL
);

CREATE UNIQUE INDEX budget_category ON Budget(category_id);

CREATE TABLE RecurringTransaction (
    id                  INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name                TEXT    NOT NULL,
    amount_minor        INTEGER NOT NULL,
    type                TEXT    NOT NULL,
    category_id         TEXT    NOT NULL,
    account_id          INTEGER NOT NULL,
    transfer_account_id INTEGER,
    payment_method      TEXT    NOT NULL,
    frequency           TEXT    NOT NULL,
    start_date          TEXT    NOT NULL,
    next_due_date       TEXT    NOT NULL,
    end_date            TEXT,
    note                TEXT,
    is_paused           INTEGER NOT NULL DEFAULT 0,
    created_at          TEXT    NOT NULL,
    FOREIGN KEY (account_id) REFERENCES Account(id)
);

CREATE INDEX recurring_next_due ON RecurringTransaction(next_due_date);
