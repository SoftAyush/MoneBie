-- Schema v5 -> v6: borrowing and lending between people.
CREATE TABLE LoanRecord (
    id                       INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    person_name              TEXT    NOT NULL,
    direction                TEXT    NOT NULL,
    principal_amount_minor   INTEGER NOT NULL,
    date                     TEXT    NOT NULL,
    due_date                 TEXT,
    notes                    TEXT,
    account_id               INTEGER,
    principal_transaction_id INTEGER,
    created_at               TEXT    NOT NULL
);

CREATE TABLE LoanRepayment (
    id             INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    record_id      INTEGER NOT NULL,
    amount_minor   INTEGER NOT NULL,
    date           TEXT    NOT NULL,
    account_id     INTEGER,
    transaction_id INTEGER,
    note           TEXT,
    FOREIGN KEY (record_id) REFERENCES LoanRecord(id)
);

CREATE INDEX loan_repayment_record ON LoanRepayment(record_id);
CREATE INDEX loan_record_direction ON LoanRecord(direction);
