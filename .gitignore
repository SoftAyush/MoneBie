# ---- Local machine & secrets ------------------------------------------------
# Points at this machine's SDK, so it is never the same twice.
local.properties
local.defaults.properties
.env
*.jks
*.keystore
keystore.properties
signing.properties
service-account*.json

# The Firebase project this build talks to, generated per project in the
# Firebase console (Project settings -> Your apps -> google-services.json).
# Ignored because it names a private project rather than anything about the
# app; drop the file back into androidApp/ to build, or delete this line to
# commit it and let a fresh clone build straight away.
androidApp/google-services.json

# Local/generated Firebase and build artifacts that are specific to this machine
# and should not be committed.
androidApp/monebie-release
firebase.json
firestore.indexes.json
firestore.rules

